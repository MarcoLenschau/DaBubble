<?xml version='1.0' encoding='utf-8'?>
<widget id="io.cordova.hellocordova" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>DaBubble</name>
    <description>Sample Apache Cordova App</description>
    <author email="contact@marco-lenschau.de" href="mailto:contact@marco-lenschau.de">
        Marco Lenschau
    </author>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <platform name="android">
        <icon src="./www/assets/img/logos/logo.png" density="mdpi" />
        <icon src="./www/assets/img/logos/logo.png" density="hdpi" />
        <icon src="./www/assets/img/logos/logo.png" density="xhdpi" />
        <icon src="./www/assets/img/logos/logo.png" density="xxhdpi" />
        <icon src="./www/assets/img/logos/logo.png" density="xxxhdpi" />
    </platform>
</widget>
